{
  "name": "city-atlas-desktop",
  "productName": "城市图志",
  "version": "0.1.0",
  "private": true,
  "description": "离线城市地图与制图工作台",
  "author": "City Atlas contributors",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "prepare:assets": "node scripts/prepare-assets.cjs",
    "start": "npm run prepare:assets && node scripts/launch.cjs",
    "smoke": "npm run prepare:assets && node scripts/launch.cjs --smoke-test",
    "pack": "npm run prepare:assets && electron-builder --dir",
    "dist": "npm run prepare:assets && electron-builder --win nsis"
  },
  "devDependencies": {
    "echarts": "6.0.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.cityatlas.desktop",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release" },
    "files": ["electron/**", "renderer/**", "resources/**", "package.json"],
    "win": { "target": "nsis", "signAndEditExecutable": false, "executableName": "CityAtlas" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "城市图志",
      "artifactName": "CityAtlas-Setup-${version}.${ext}"
    }
  }
}
