{
  "name": "urbis",
  "productName": "江城子",
  "version": "1.0.0",
  "private": true,
  "description": "离线城市地图与制图工作台",
  "author": {
    "name": "Miles Li / 里缪"
  },
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node node_modules/electron/install.js",
    "prepare:assets": "node scripts/prepare-assets.cjs",
    "audit:maps": "npm run prepare:assets && node scripts/audit-maps.cjs",
    "start": "npm run prepare:assets && node scripts/launch.cjs",
    "smoke": "npm run prepare:assets && node scripts/launch.cjs --smoke-test",
    "pack": "npm run prepare:assets && electron-builder --dir",
    "dist": "npm run prepare:assets && electron-builder --win nsis"
  },
  "devDependencies": {
    "echarts": "6.0.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "pinyin-pro": "3.27.0",
    "polygon-clipping": "0.15.7",
    "prettier": "3.6.2"
  },
  "build": {
    "appId": "org.cityatlas.desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "renderer/**",
      "resources/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "executableName": "Urbis",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "江城子",
      "artifactName": "Urbis-Setup-${version}.${ext}"
    }
  }
}
